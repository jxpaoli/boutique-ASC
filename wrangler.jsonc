// Config du Worker gestion-projets-europeens : site statique (dist/) servi en mode SPA.
// Adresse officielle unique : https://europa.master.corsica (workers.dev desactive).
{
  "name": "gestion-projets-europeens",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "europa.master.corsica", "custom_domain": true }
  ]
}
